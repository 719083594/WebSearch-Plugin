{
  "name": "websearch-plugin",
  "version": "2.0.0",
  "description": "框架独立的联网搜索Node API与JSON/文字/PNG命令行，提供云崽及可选Chaite适配。",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "719083594",
  "repository": {
    "type": "git",
    "url": "https://github.com/719083594/WebSearch-Plugin.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "main": "./api.mjs",
  "exports": {
    ".": "./api.mjs",
    "./commands": "./lib/commands.mjs",
    "./runtime": "./lib/runtime.mjs",
    "./search-client": "./search-client.mjs",
    "./cli": "./cli.mjs"
  },
  "bin": {"web-search": "./cli.mjs"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "diagnose": "node cli.mjs diagnose"
  },
  "files": [
    "index.js",
    "api.mjs",
    "cli.mjs",
    "search-client.mjs",
    "lib",
    "renderer",
    "config/plugin.example.json",
    "scripts",
    "integrations",
    "requirements.txt",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md",
    "guoba.support.js",
    "resources",
    "orangejuice.plugin.json"
  ]
}
