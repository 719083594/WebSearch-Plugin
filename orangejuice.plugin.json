{
  "schemaVersion": 1,
  "title": "联网搜索",
  "description": "通用联网搜索，提供程序接口、命令行和云崽桥接；附来源与搜索时间。",
  "homepage": "https://github.com/719083594/WebSearch-Plugin",
  "commands": [
    "#搜索 关键词",
    "#搜文 关键词",
    "#搜图 关键词",
    "#搜索帮助",
    "#搜索诊断（仅主人）"
  ],
  "configs": [
    {
      "id": "plugin",
      "title": "搜索配置",
      "file": "config/plugin.json",
      "example": "config/plugin.example.json",
      "reload": "restart",
      "fields": [
        {
          "path": "provider",
          "label": "搜索后端（auto 自动 / bing 必应 / 360 搜索 / sogou 搜狗 / endpoint 认证服务）",
          "type": "string"
        },
        {
          "path": "endpoint",
          "label": "认证搜索服务地址（仅认证服务后端需要）",
          "type": "string"
        },
        {
          "path": "secret",
          "label": "认证搜索服务密钥（本地保存，界面遮罩）",
          "type": "string"
        },
        {
          "path": "pythonPath",
          "label": "Python 命令",
          "type": "string"
        },
        {
          "path": "fontPath",
          "label": "中文字体路径",
          "type": "string"
        },
        {
          "path": "timeoutMs",
          "label": "搜索等待上限（毫秒）",
          "type": "integer",
          "min": 1000,
          "max": 30000
        },
        {
          "path": "sourceTimeoutMs",
          "label": "单搜索源等待上限（毫秒）",
          "type": "integer",
          "min": 1000,
          "max": 10000
        },
        {
          "path": "maxResults",
          "label": "最多结果数",
          "type": "integer",
          "min": 1,
          "max": 8
        },
        {
          "path": "masterOnly",
          "label": "仅主人可搜索",
          "type": "boolean"
        },
        {
          "path": "cooldownMs",
          "label": "搜索冷却（毫秒）",
          "type": "integer",
          "min": 0,
          "max": 600000
        },
        {
          "path": "timeZone",
          "label": "显示时区",
          "type": "string"
        }
      ]
    }
  ]
}
